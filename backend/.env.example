DB_USERNAME=postgres
DB_PASSWORD=preencha_a_senha_do_banco

# Portas utilizadas apenas com compose.local.yaml.
LOCAL_API_PORT=8082
LOCAL_DB_PORT=5433

# formatos aceitos: hexadecimal ou Base64.
JWT_ACCESS_SECRET=preencha_com_uma_chave_aleatoria
JWT_REFRESH_SECRET=preencha_com_outra_chave_aleatoria

GEMINI_API_KEY=preencha_sua_chave_gemini

# Tentativas de login (inclusive válidas) por janela de 15 minutos.
LOGIN_EMAIL_LIMIT=10
LOGIN_ORIGIN_LIMIT=100
LOGIN_WINDOW_SECONDS=900

# Limites de análises por instância. Tentativas com falha também contam.
AI_PER_MINUTE=5
AI_PER_DAY=50
AI_GLOBAL_PER_DAY=500
AI_PER_USER_CONCURRENT=1
AI_GLOBAL_CONCURRENT=4
AI_MAX_INPUT_BYTES=100000
AI_MAX_OUTPUT_TOKENS=2048

# SMTP: as credenciais ficam somente no backend.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=seu_usuario_smtp
SMTP_PASSWORD=sua_senha_smtp
SMTP_FROM=no-reply@seu-dominio.com
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_SSL_ENABLE=false

# URL pública da tela de redefinição. O backend acrescenta ?token=...
# Para testes pelo celular, use o IP do PC no lugar de localhost.
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Planejamento financeiro com Gemini (desativado até autorização).
ASSISTANT_PLANNING_ENABLED=false
ASSISTANT_MAX_INPUT_BYTES=100000
ASSISTANT_MAX_OUTPUT_TOKENS=4096

# Aplicar views/permissões e provisionar uma senha exclusiva antes de habilitar.
ASSISTANT_EXECUTION_ENABLED=false
ASSISTANT_READER_JDBC_URL=jdbc:postgresql://localhost:5433/vikash_db
ASSISTANT_READER_USERNAME=vikash_assistant_reader
ASSISTANT_READER_PASSWORD=
ASSISTANT_READER_POOL_SIZE=4
ASSISTANT_PLAN_TIMEOUT_MS=1000
ASSISTANT_QUERY_TIMEOUT_MS=2000
ASSISTANT_TRANSACTION_TIMEOUT_MS=5000
ASSISTANT_MAX_QUERY_COST=100000
ASSISTANT_MAX_ESTIMATED_ROWS=1000000

# Segunda chamada ao Gemini: resultado da consulta -> resposta financeira.
ASSISTANT_ANSWER_ENABLED=false
ASSISTANT_ANSWER_MAX_INPUT_BYTES=100000
ASSISTANT_ANSWER_MAX_OUTPUT_TOKENS=2048

# Resumo incremental e filtros, na mesma chamada de planejamento.
ASSISTANT_MEMORY_ENABLED=false
